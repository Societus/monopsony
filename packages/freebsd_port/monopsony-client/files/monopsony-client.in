#!/bin/sh
# $FreeBSD$

# PROVIDE: monopsony_client
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name=monopsony_client
rcvar=monopsony_client_enable

load_rc_config ${name}

: ${monopsony_client_enable:="NO"}
: ${monopsony_client_config:="/etc/monopsony/client.toml"}
: ${monopsony_client_proxy_addr:="127.0.0.1:3129"}
: ${monopsony_client_user:="root"}

command=/usr/local/bin/monopsony-client
command_args="daemon --config ${monopsony_client_config} --proxy-addr ${monopsony_client_proxy_addr}"
pidfile=/var/run/${name}.pid

start_precmd="${name}_prestart"

monopsony_client_prestart()
{
    if [ ! -f "${monopsony_client_config}" ]; then
        echo "No config file at ${monopsony_client_config}."
        echo "Copy /usr/local/etc/monopsony/client.toml.example to ${monopsony_client_config} and edit."
        return 1
    fi
}

run_rc_command "$1"
