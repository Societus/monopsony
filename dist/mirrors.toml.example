# upstream_url = "https://dl-cdn.alpinelinux.org/alpine/"
# local_path = "/var/cache/monopsony/mirrors/alpine"
# sync_enabled = true
# sync_interval_secs = 21600   # 6 hours
#
# exclude_patterns = [
#     "*/releases/*",   # Skip release ISOs
#     "*/edge/*",       # Skip edge (rolling) if not needed
# ]
#
# public = true
# per_ip_rps = 50
