# Monopsony Server Configuration
# 
# This is the main configuration file for monopsony-server.
# All fields are required unless noted with a default value.
# Place at /etc/monopsony/server.toml

# ============================================================================
# HTTP Cache Proxy
# ============================================================================
[server]
# Address to bind the HTTP caching proxy.
# Clients send their package manager traffic here.
# Type: string (host:port)
bind = "0.0.0.0:3128"

# Optional hostname for TLS certificate Subject Alternative Name.
# If not set, the system hostname is used.
# Type: string (optional)
# hostname = "my-monopsony-server"

# ============================================================================
# gRPC Control Plane
# ============================================================================
[grpc]
# Address for the gRPC control plane (client registration, heartbeats,
# inventory reporting). Requires mTLS — clients must present a valid
# certificate signed by the Monopsony CA.
# Type: string (host:port)
bind = "0.0.0.0:50051"

# ============================================================================
# PostgreSQL Database
# ============================================================================
[database]
# PostgreSQL connection URL.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For local PostgreSQL: postgres://monopsony:PASSWORD@localhost/monopsony
# The installer generates this automatically.
# Type: string
url = "postgres://monopsony:changeme@localhost/monopsony"

# Maximum number of connections in the pool.
# Default: 10. Increase for offices with 50+ clients.
# Type: u32
max_connections = 10

# ============================================================================
# Cache Storage
# ============================================================================
[cache]
# Directory for cached package files and metadata.
# Will be created if it doesn't exist.
# Type: path
path = "/var/cache/monopsony"

# Maximum total cache size in gigabytes.
# Oldest or least-used packages are evicted when the limit is reached.
# Type: u64
max_size_gb = 50

# Days before purging unreferenced packages.
# Packages not requested by any client in this period are eligible for
# eviction. Default: 30
# Type: u32
# purge_after_days = 30

# ============================================================================
# TLS / mTLS
# ============================================================================
[tls]
# Paths to the Monopsony private CA and server certificates.
# The CA is generated by `monopsony-server` on first run or by the installer.
# Client certificates are generated during pairing.

# CA certificate (PEM format)
# Type: path
ca_path = "/var/lib/monopsony/ca.pem"

# CA private key (PEM format)
# Type: path
ca_key_path = "/var/lib/monopsony/ca.key"

# Server certificate (PEM format, signed by the CA above)
# Type: path
server_cert_path = "/var/lib/monopsony/server.pem"

# Server private key (PEM format)
# Type: path
server_key_path = "/var/lib/monopsony/server.key"

# ============================================================================
# Discovery
# ============================================================================
[discovery]
# Enable mDNS (multicast DNS) server discovery.
# Clients on the same LAN can find the server automatically.
# Default: true
# Type: bool
# mdns_enabled = true

# mDNS service name. Must match on client and server.
# Default: "monopsony-server"
# Type: string
# mdns_service_name = "monopsony-server"

# ============================================================================
# Prometheus Metrics
# ============================================================================
[metrics]
# Enable the Prometheus metrics endpoint.
# Default: true
# Type: bool
# enabled = true

# Address for the metrics HTTP endpoint.
# Default: "0.0.0.0:9090"
# Type: string (host:port)
# bind = "0.0.0.0:9090"

# URL path for metrics scraping.
# Default: "/metrics"
# Type: string
# path = "/metrics"

# ============================================================================
# Logging
# ============================================================================
[logging]
# Log level: trace, debug, info, warn, error
# Default: "info"
# Type: string
# level = "info"

# Log format: "json" (structured, for log aggregators) or "pretty" (human-readable)
# Default: "json"
# Type: string
# format = "json"

# ============================================================================
# Shadow Package Trust
# ============================================================================
# Controls how the server and clients verify recipe signatures before
# applying shadow package updates. Recipes are signed with Ed25519 keys;
# this section configures which signatures are required.
[shadow_trust]

# Trust policy — determines which signatures are checked before a recipe
# is accepted for execution.
#
# Options:
#   "trusted_server_only" (default)
#     Only the server operator's countersignature is required.
#     Use when you control the server and all recipes yourself.
#
#   "trusted_authors"
#     Recipes must be signed by a trusted author key. The operator
#     signature is not checked. Use when federating recipes from
#     external authors you trust.
#
#   "paranoid"
#     Both the operator countersignature AND a trusted author signature
#     are required. Use for maximum security in federated deployments.
#
# Default: "trusted_server_only"
# Type: string
# policy = "trusted_server_only"

# List of trusted author key IDs (hex, first 8 bytes of the Ed25519 public key).
# Only used with "trusted_authors" or "paranoid" policies.
# Generate keys with: monopsony-server shadow keygen
#
# Default: [] (empty — no trusted authors)
# Type: array of strings
# trusted_author_keys = []

# List of trusted operator key IDs. Used to verify the server operator's
# countersignature on federated recipes received from other servers.
#
# Default: [] (empty — operator key is loaded from server state)
# Type: array of strings
# trusted_operator_keys = []

# ============================================================================
# Malware Scanning
# ============================================================================
# Post-cache malware scanning for cached artifacts.
# Run `monopsony-server setup` for interactive configuration.
# Disabled by default.
[scan]

# Enable post-cache malware scanning (ClamAV + YARA).
# Default: false
# Type: bool
# enabled = false

# Path to ClamAV daemon socket (clamd.ctl).
# Required when enabled = true and using ClamAV.
# Type: path
# clamav_socket = "/var/run/clamav/clamd.ctl"

# Directory containing YARA rule files (.yar).
# Created by `monopsony-server setup` if scanning is enabled.
# Type: path
# yara_rules_dir = "/etc/monopsony/yara-rules"

# Block serving artifacts when malware is detected.
# If false, artifacts are served with X-Scan-Warning header.
# Default: true
# Type: bool
# block_on_malware = true

# Warn when cached artifacts match known CVEs (OSV database lookup).
# Adds X-Scan-Warning header but does not block.
# Default: true
# Type: bool
# warn_on_cve = true

# Shannon entropy threshold (0.0–8.0) for anomaly detection.
# Artifacts above this threshold are flagged.
# Default: 7.5
# Type: f64
# entropy_threshold = 7.5

# ============================================================================
# Node Tier
# ============================================================================
# Deployment tier controls which features are required.
# Run `monopsony-server setup` for interactive configuration.
[node]

# Tier: private (default), public, or federated.
#
#   private   — homelab, air-gap, testing. No restrictions.
#   public    — internet-facing, serves other clients. Requires S3 + scanning.
#   federated — participates in mesh network. Requires scanning.
#
# Default: "private"
# Type: string
# tier = "private"

# Node name for federation identification.
# Required for public and federated tiers.
# Type: string (optional)
# name = "my-monopsony-node"

# ============================================================================
# S3 Cache Storage (optional)
# ============================================================================
# Uncomment and configure when using S3-compatible storage backend.
# Required for public tier.
#
# [cache.s3]
# endpoint = "http://127.0.0.1:8333"
# region = "us-east-1"
# bucket = "monopsony-cache"
# access_key = "ACCESS_KEY"
# secret_key = "SECRET_KEY"
# force_path_style = true
# retention_days = 7

# SSE-C encryption key path (32 bytes, mode 0600).
# Generated by `monopsony-server setup`.
# Type: path
# encryption_key_path = "/etc/monopsony/s3-encryption.key"
